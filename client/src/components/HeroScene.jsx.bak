import { useState } from "react";
import { motion } from "framer-motion";
import { Link } from "react-router-dom";
import {
  ShieldCheck,
  Tv,
  GraduationCap,
  Briefcase,
  Play,
  Maximize2,
  ArrowRight
} from "lucide-react";

const floatingCards = [
  {
    id: "cert",
    title: "AAPC & AHIMA",
    subtitle: "Preparation",
    icon: ShieldCheck,
    iconBg: "bg-[#E6F8F0] text-[#10B981]",
    link: "/courses"
  },
  {
    id: "classes",
    title: "Live & Recorded",
    subtitle: "Classes",
    icon: Tv,
    iconBg: "bg-[#EBF5FF] text-[#2563EB]",
    link: "/courses"
  },
  {
    id: "mentors",
    title: "Expert Trainers",
    subtitle: "& Mentorship",
    icon: GraduationCap,
    iconBg: "bg-[#F3E8FF] text-[#9333EA]",
    link: "/about"
  },
  {
    id: "placement",
    title: "Placement",
    subtitle: "Assistance",
    icon: Briefcase,
    iconBg: "bg-[#FFF4E6] text-[#F97316]",
    link: "/placements"
  }
];

export default function HeroScene({ onPlayVideo }) {
  const [isHovered, setIsHovered] = useState(false);

  return (
    <div className="relative w-full max-w-[620px] lg:max-w-none mx-auto flex items-center justify-center lg:justify-end">
      {/* Container holding the video card and the floating cards */}
      <div className="relative w-full flex flex-col md:flex-row items-center md:items-stretch gap-4 sm:gap-6">
        
        {/* Central Main Video Card */}
        <motion.div
          initial={{ opacity: 0, scale: 0.95 }}
          animate={{ opacity: 1, scale: 1 }}
          transition={{ duration: 0.8 }}
          className="relative flex-1 w-full max-w-[460px] md:max-w-[480px] lg:max-w-[500px] aspect-[4/3] rounded-[28px] sm:rounded-[36px] overflow-hidden border-4 border-white bg-slate-900 shadow-[0_25px_60px_-15px_rgba(15,23,42,0.18)] group cursor-pointer select-none"
          onClick={onPlayVideo}
          onMouseEnter={() => setIsHovered(true)}
          onMouseLeave={() => setIsHovered(false)}
        >
          {/* Doctor Video Poster Image */}
          <img
            src="/hero-doctor-clean.png"
            alt="Real Learning Real Careers - Medical Coding Trainer"
            className="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
          />

          {/* Chalk Handwritten Text Top-Left */}
          <div className="absolute top-4 sm:top-5 left-5 sm:left-6 z-20 pointer-events-none">
            <div className="font-handwriting text-white/95 text-xl sm:text-2xl font-bold leading-tight -rotate-3 drop-shadow-[0_2px_4px_rgba(0,0,0,0.6)]">
              <div>Real</div>
              <div className="pl-1">Learning</div>
              <div className="pl-2">Real Careers</div>
              <div className="w-12 h-1 border-b-2 border-white/80 rounded-full mt-0.5 ml-2" />
            </div>
          </div>

          {/* Center Play Button with Soft Ripple */}
          <div className="absolute inset-0 flex items-center justify-center z-20">
            <motion.div
              animate={{
                scale: isHovered ? 1.12 : [1, 1.05, 1],
                boxShadow: isHovered
                  ? "0 0 40px rgba(255,255,255,0.9)"
                  : "0 10px 30px rgba(0,0,0,0.3)"
              }}
              transition={{
                duration: 2.2,
                repeat: isHovered ? 0 : Infinity,
                ease: "easeInOut"
              }}
              className="w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-white flex items-center justify-center shadow-2xl transition-all duration-300"
            >
              <Play className="w-6 h-6 sm:w-7 sm:h-7 fill-[#0B1528] text-[#0B1528] ml-1 transition-transform group-hover:scale-110" />
            </motion.div>
          </div>

          {/* Bottom Video Progress & Controls Bar */}
          <div className="absolute bottom-0 inset-x-0 z-20 pt-8 pb-3.5 px-4 sm:px-5 bg-gradient-to-t from-black/85 via-black/40 to-transparent flex flex-col gap-2">
            {/* Scrubber Line */}
            <div className="relative w-full h-1 sm:h-1.5 bg-white/30 rounded-full overflow-visible">
              <div className="absolute left-0 top-0 bottom-0 w-[38%] bg-white rounded-full" />
              <div className="absolute left-[38%] top-1/2 -translate-x-1/2 -translate-y-1/2 w-3 h-3 rounded-full bg-white shadow-md transition-transform group-hover:scale-125" />
            </div>

            {/* Bottom Controls Row */}
            <div className="flex items-center justify-between text-white text-xs sm:text-[13px] font-medium tracking-wide pt-0.5">
              <div className="flex items-center gap-2">
                <Play className="w-3.5 h-3.5 fill-white text-white" />
              </div>
              <div className="flex items-center gap-3">
                <span className="font-mono text-white/90 text-[11px] sm:text-xs">
                  00:00 / 01:00
                </span>
                <Maximize2 className="w-3.5 h-3.5 text-white/90 hover:text-white transition-colors" />
              </div>
            </div>
          </div>
        </motion.div>

        {/* Right Stack of 4 Floating Cards */}
        <div className="w-full md:w-[220px] lg:w-[240px] flex flex-col justify-between gap-3 sm:gap-3.5 z-20">
          {floatingCards.map((card, idx) => {
            const Icon = card.icon;
            return (
              <motion.div
                key={card.id}
                initial={{ opacity: 0, x: 20 }}
                animate={{ opacity: 1, x: 0 }}
                transition={{ duration: 0.6, delay: 0.15 * idx }}
              >
                <Link
                  to={card.link}
                  className="group flex items-center justify-between bg-white/95 hover:bg-white backdrop-blur-md rounded-2xl p-3 sm:p-3.5 border border-slate-100/90 shadow-[0_8px_25px_-5px_rgba(15,23,42,0.06)] hover:shadow-[0_12px_30px_-5px_rgba(37,99,235,0.12)] hover:border-sky-200 transition-all duration-300 hover:-translate-y-0.5"
                >
                  <div className="flex items-center gap-3">
                    <div
                      className={`w-10 h-10 rounded-xl flex items-center justify-center shrink-0 shadow-sm ${card.iconBg}`}
                    >
                      <Icon className="w-5 h-5" />
                    </div>
                    <div className="text-left">
                      <div className="text-xs sm:text-sm font-extrabold text-[#0B1528] leading-tight group-hover:text-blue-600 transition-colors">
                        {card.title}
                      </div>
                      <div className="text-[11px] text-slate-500 font-medium">
                        {card.subtitle}
                      </div>
                    </div>
                  </div>
                  <ArrowRight className="w-4 h-4 text-slate-300 group-hover:text-blue-600 group-hover:translate-x-1 transition-all duration-300 shrink-0 ml-1" />
                </Link>
              </motion.div>
            );
          })}
        </div>

      </div>
    </div>
  );
}
